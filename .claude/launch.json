{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "emara-dev",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-c",
        "export PATH=\"$HOME/.local/node22/bin:$PATH\" && npm run dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "emara-prod",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-c",
        "export PATH=\"$HOME/.local/node22/bin:$PATH\" && npm run start -- -p 3999"
      ],
      "port": 3999
    }
  ]
}
